# IATMSI-2027 — server environment.
#
# Copy to `.env.local` for local development. In production these belong in
# Vercel -> Project -> Settings -> Environment Variables, and nowhere else.
#
# Anything here is server-only. Vite exposes variables to the browser only when
# they are prefixed `VITE_`, so none of these can leak into the bundle.

# --- Visitor counter ------------------------------------------------------
# Upstash Redis, added through Vercel -> Storage. The counter holds only
# per-country totals; without these the footer simply shows nothing.
KV_REST_API_URL=
KV_REST_API_TOKEN=
