# IATMSI-2027 — server environment.
#
# Copy to `.env.local` for local development. In production these belong in
# Vercel -> Project -> Settings -> Environment Variables, and nowhere else:
# never in this repository, and never pasted into chat or email.
#
# Anything here is server-only. Vite exposes variables to the browser only when
# they are prefixed `VITE_`, so none of these can leak into the bundle.

# --- Cashfree payment gateway --------------------------------------------
# Dashboard -> Developers -> API Keys. Sandbox keys until the account is live.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# "sandbox" (default) or "production". Test with sandbox first; switching to
# production also switches the API host, so nothing else needs changing.
CASHFREE_MODE=sandbox

# --- Supabase (registration records) -------------------------------------
# Dashboard -> Project Settings -> API.
SUPABASE_URL=
# The SERVICE ROLE key, not the anon key. It bypasses row-level security, which
# is how the API reads and writes these tables — and exactly why it must never
# reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Receipt email --------------------------------------------------------
# A Gmail App Password (Google Account -> Security -> 2-Step Verification ->
# App passwords), not the account password. It can be revoked on its own.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=IATMSI 2027 <iatmsi2027@example.org>

# --- Scheduled reconciliation --------------------------------------------
# Any long random string, e.g. `openssl rand -hex 32`. Vercel Cron sends it as
# `Authorization: Bearer <value>` to /api/reconcile-payments, which sweeps up
# payments whose webhook never arrived. Without it that endpoint refuses every
# caller, including the cron — so the safety net is off until this is set.
CRON_SECRET=

# --- Site address ---------------------------------------------------------
# Used to build the return and webhook URLs given to Cashfree. Set this in
# production; without it the code falls back to Vercel's own domain variable.
# It is never taken from the request's Host header, which a caller controls.
SITE_URL=https://iatmsi2027.example.org

# --- Visitor counter (already in use) ------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
